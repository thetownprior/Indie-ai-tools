---
import { hostname } from '../lib/urls';

interface Props {
  name: string;
  website: string;
  affiliateUrl?: string;
}

const { name, website, affiliateUrl } = Astro.props;
const affiliate = Boolean(affiliateUrl);
const primary = affiliateUrl ?? website;
const rel = affiliate ? 'sponsored nofollow noopener' : 'noopener';
---

<div class="cta">
  <a class="button" href={primary} rel={rel} target="_blank">Visit {name}</a>
  {
    affiliate ? (
      <a class="text-link" href={website} rel="noopener" target="_blank">
        Official website · {hostname(website)}
      </a>
    ) : (
      <span>{hostname(website)}</span>
    )
  }
</div>
{
  affiliate && (
    <p class="disclosure">
      Affiliate link. The button uses <code>rel="sponsored nofollow"</code>.
    </p>
  )
}
