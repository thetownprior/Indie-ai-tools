---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolList from '../../components/ToolList.astro';
import { breadcrumbJsonLd, itemListJsonLd } from '../../lib/seo';
import { getTagGroups, type TermGroup } from '../../lib/tools';

export async function getStaticPaths() {
  const tags = await getTagGroups();
  return tags.map((tag) => ({
    params: { slug: tag.slug },
    props: { tag },
  }));
}

interface Props {
  tag: TermGroup;
}

const { tag } = Astro.props;
const description = `Indie AI tools tagged ${tag.name}. Short reviews for solo creators and small businesses.`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'All tools', path: '/tools/' },
  { name: tag.name, path: `/tag/${tag.slug}/` },
];
---

<BaseLayout
  title={`Tools tagged ${tag.name}`}
  description={description}
  jsonLd={[itemListJsonLd(`Tools tagged ${tag.name}`, tag.tools), breadcrumbJsonLd(crumbs)]}
>
  <Breadcrumbs items={crumbs} />
  <p class="kicker">Tag</p>
  <h1 class="page-title">{tag.name}</h1>
  <p class="lede">{description}</p>
  <ToolList tools={tag.tools} />
</BaseLayout>
